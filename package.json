{
  "name": "modelviz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "python3 scripts/infisical/run.py dev",
    "build": "vite build",
    "preview": "node scripts/dev-server.mjs vite preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "dev:app": "node scripts/dev-server.mjs vite --host 127.0.0.1",
    "build:secrets": "python3 scripts/infisical/run.py build",
    "secrets:check": "python3 scripts/infisical/run.py check",
    "secrets:migrate:keyenv": "python3 scripts/infisical/migrate_keyenv.py",
    "test:secrets": "python3 -m unittest discover -s scripts/infisical -p test_secrets.py",
    "secrets:sync:production": "python3 scripts/infisical/sync_production.py"
  },
  "dependencies": {
    "@sentry/react": "10.69.0",
    "@vercel/analytics": "1.6.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@sentry/vite-plugin": "5.4.0",
    "brace-expansion": "5.0.12",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
