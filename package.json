{
  "name": "modelviz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev-server.mjs vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "node scripts/dev-server.mjs vite preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "secrets:sync:production": "python3 scripts/infisical/sync_production.py",
    "test:production-sync": "python3 -B -m unittest discover -s scripts/infisical -p test_production_sync.py"
  },
  "dependencies": {
    "@sentry/react": "11.10.0",
    "@vercel/analytics": "2.0.1",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@sentry/vite-plugin": "11.10.0",
    "brace-expansion": "5.0.12",
    "nanoid": "6.0.2",
    "postcss": "8.5.32"
  }
}
